@model FPPR_System.Common.Models.LikeListInput

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<input type="hidden" asp-for="UserID" />

<div class="mb-3">
    <label asp-for="ProductName" class="form-label"></label>
    <input asp-for="ProductName" class="form-control" maxlength="100" />
    <span asp-validation-for="ProductName" class="text-danger small"></span>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-sm-6">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="Price" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-6">
        <label asp-for="FeeRate" class="form-label"></label>
        <input asp-for="FeeRate" type="number" step="0.0001" min="0" max="1" class="form-control" />
        <div class="form-text">以小數表示，例：0.01 代表 1%</div>
        <span asp-validation-for="FeeRate" class="text-danger small"></span>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6">
        <label asp-for="PurchaseQuantity" class="form-label"></label>
        <input asp-for="PurchaseQuantity" type="number" step="1" min="1" class="form-control" />
        <span asp-validation-for="PurchaseQuantity" class="text-danger small"></span>
    </div>
    <div class="col-12 col-sm-6">
        <label asp-for="Account" class="form-label"></label>
        <input asp-for="Account" class="form-control" inputmode="numeric" maxlength="20" />
        <span asp-validation-for="Account" class="text-danger small"></span>
    </div>
</div>
