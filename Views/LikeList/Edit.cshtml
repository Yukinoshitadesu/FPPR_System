@model FPPR_System.Common.Models.LikeListInput
@{
    ViewData["Title"] = "修改喜好金融商品";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <h1 class="h3 mb-1">修改喜好金融商品</h1>
        <p class="text-muted mb-4">使用者：@ViewData["UserName"]（@Model.UserID）</p>

        <form asp-action="Edit" method="post" novalidate>
            <input type="hidden" asp-for="SN" />
            <partial name="_LikeListFormFields" model="Model" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">儲存</button>
                <a asp-action="Index" asp-route-userId="@Model.UserID" class="btn btn-outline-secondary">取消</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
